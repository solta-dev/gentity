func ({{ .GoName }}) Query(ctx context.Context, sql string, values []interface{}) (entities {{ .GoName }}s, err error) {

    {{ .GoName }}{}.doQueryWithRowsCB(ctx, sql, values, func(ent *{{ .GoName }}, e error) bool {
